---
import PostCard from '../../components/PostCard.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPublishedPosts } from '../../lib/posts'

const posts = await getPublishedPosts()
const hasPosts = posts.length > 0
---

<BaseLayout title="Writing" description="Technical notes and experiments from Nathan Bland.">
  <header class="page-heading">
    <p class="eyebrow">Writing</p>
    <h1 class="section-heading">Notes from the trail.</h1>
    <p class="section-intro">
      Technical notes and project writeups. Some are new, some are from older versions of this site.
    </p>
  </header>
  <section class="post-grid" aria-label="Articles">
    {hasPosts ? posts.map((post) => <PostCard post={post} />) : (
      <p class="empty-state">No articles published yet.</p>
    )}
  </section>
</BaseLayout>

<style>
  .page-heading { margin-bottom: var(--section-spacing-offset); padding: clamp(2rem, 6vw, 5rem) 0; }
  .page-heading .eyebrow { color: var(--sunset); }
  .post-grid { display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); padding-bottom: 3rem; }
  .empty-state {
    background: rgb(255 253 248 / 92%);
    border-radius: 1rem;
    color: var(--ink-soft);
    grid-column: 1 / -1;
    line-height: var(--paragraph-leading);
    margin: 0;
    padding: 1rem 1.2rem;
  }
  @media (max-width: 680px) { .post-grid { grid-template-columns: 1fr; } }
</style>
