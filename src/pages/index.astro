---
import { Image } from 'astro:assets'
import PostCard from '../components/PostCard.astro'
import SocialLinks from '../components/SocialLinks.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import profile from '../assets/profile.jpg'
import { getPublishedPosts } from '../lib/posts'

const posts = (await getPublishedPosts()).slice(0, 3)
---

<BaseLayout>
  <section class="hero">
    <div class="portrait-wrap">
      <Image
        class="portrait"
        src={profile}
        alt="Nathan Bland outdoors in winter"
        width={620}
        height={620}
        loading="eager"
      />
    </div>
    <div class="intro">
      <p class="eyebrow">Hello, I’m Nathan</p>
      <h1>Developer.<br /><span>Outdoor enthusiast.</span></h1>
      <p>
        I use this site for technical notes, small projects,
        and notes I want to keep around.
      </p>
      <SocialLinks />
    </div>
  </section>

  <section class="latest" aria-labelledby="latest-heading">
    <div class="latest-heading">
      <div>
        <p class="eyebrow">From the archive</p>
        <h2 id="latest-heading">Latest writing</h2>
      </div>
      <a href="/blog">View all articles <span aria-hidden="true">→</span></a>
    </div>
    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    align-items: center;
    display: grid;
    gap: clamp(2rem, 7vw, 6rem);
    grid-template-columns: minmax(15rem, 0.8fr) 1.2fr;
    min-height: 65vh;
    padding: 2rem clamp(0rem, 3vw, 2rem) 5rem;
  }

  .portrait-wrap {
    background: linear-gradient(135deg, var(--teal), var(--sunset));
    border-radius: 48% 52% 45% 55% / 42% 45% 55% 58%;
    box-shadow: 0 2rem 5rem rgb(4 20 29 / 35%);
    padding: 0.35rem;
    transform: rotate(-2deg);
  }

  .portrait-wrap :global(img) {
    border-radius: inherit;
    display: block;
    height: auto;
    width: 100%;
  }

  .intro .eyebrow { color: var(--sunset); }
  h1 {
    color: var(--paper);
    font-size: clamp(3rem, 8vw, 6.8rem);
    letter-spacing: -0.065em;
    line-height: 0.88;
    margin: 0;
  }
  h1 span { color: var(--teal); }
  .intro > p:not(.eyebrow) {
    color: var(--mist);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.65;
    max-width: 38rem;
  }

  .latest {
    background: rgb(10 31 41 / 72%);
    border: 1px solid var(--line);
    border-radius: 1.5rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }
  .latest-heading { align-items: end; display: flex; justify-content: space-between; margin-bottom: 1.5rem; }
  .latest-heading h2 { color: var(--paper); font-size: clamp(2rem, 5vw, 3.5rem); letter-spacing: -0.05em; line-height: 1; margin: 0; }
  .latest-heading > a { color: var(--mist); font-weight: 700; text-decoration: none; }
  .latest-heading > a:hover { color: var(--sunset); }
  .latest .eyebrow { color: var(--teal); }
  .post-grid { display: grid; gap: 1rem; grid-template-columns: repeat(3, 1fr); }

  @media (max-width: 840px) {
    .hero { grid-template-columns: 1fr; padding-top: 1rem; }
    .portrait-wrap { margin: 0 auto; max-width: 24rem; }
    .intro { text-align: center; }
    .intro > p:not(.eyebrow) { margin-inline: auto; }
    .intro :global(.social-links) { justify-content: center; }
    .post-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .latest-heading { align-items: flex-start; flex-direction: column; gap: 1rem; }
  }
</style>
