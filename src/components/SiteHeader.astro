---
const pathname = Astro.url.pathname

const links = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/experience' },
  { label: 'Writing', href: '/blog' }
]

const isCurrent = (href: string) => href === '/'
  ? pathname === '/'
  : pathname === href || pathname.startsWith(`${href}/`)
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Nathan Bland, home">
    <span>Nathan Bland</span><span class="dot">.dev</span>
  </a>
  <nav aria-label="Primary navigation">
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    align-items: center;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    background: var(--ink-glass);
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin: 1rem 0 2rem;
    padding: 0.8rem 1rem;
    position: sticky;
    inset-block-start: max(1rem, env(safe-area-inset-top, 0px));
    z-index: 10;
  }

  .wordmark {
    align-items: center;
    color: var(--paper);
    display: inline-flex;
    flex-shrink: 0;
    font-weight: 750;
    letter-spacing: calc(var(--heading-tracking-prose) + var(--heading-tracking-offset));
    min-height: var(--tap-target);
    text-decoration: none;
  }

  .dot { color: var(--sunset); }

  nav { min-width: 0; }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    justify-content: flex-end;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    align-items: center;
    border-radius: 999px;
    color: var(--mist);
    display: inline-flex;
    font-size: 0.9rem;
    font-weight: 650;
    min-height: var(--tap-target);
    padding: 0 0.75rem;
    text-decoration: none;
    transition: background-color 140ms ease, color 140ms ease;
  }

  nav a[aria-current='page'] {
    background: var(--paper);
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    nav a:hover {
      background: var(--paper);
      color: var(--ink);
    }
  }

  @media (max-width: 560px) {
    .site-header {
      gap: 0.35rem;
      padding: 0.6rem 0.7rem;
    }
    .wordmark { font-size: 0.95rem; }
    ul { flex-wrap: nowrap; }
    nav a { font-size: 0.9rem; padding-inline: 0.55rem; }
  }

  @media (max-width: 350px) {
    .wordmark { font-size: 0.9rem; }
    nav a { padding-inline: 0.45rem; }
  }
</style>
