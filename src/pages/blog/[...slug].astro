---
import { render, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPublishedPosts } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post }
  }))
}

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { Content } = await render(post)
const displayDate = post.data.pubDate.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
})
const publishedTime = post.data.pubDate.toISOString()
const canonical = new URL(`/blog/${post.data.slug}`, Astro.site)
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishedTime,
  author: { '@type': 'Person', name: 'Nathan Bland' },
  mainEntityOfPage: canonical.href
}
const jsonLd = JSON.stringify(structuredData).replaceAll('<', '\\u003c')
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  article
  publishedTime={publishedTime}
>
  <article class="article-shell">
    <a class="back" href="/blog"><span aria-hidden="true">←</span> All writing</a>
    <header>
      <p class="eyebrow">From the archive</p>
      <h1>{post.data.title}</h1>
      <time datetime={publishedTime}>{displayDate}</time>
      <p class="archive-note">
        Old post. Formatting cleaned up. Technical details may be dated.
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <script is:inline type="application/ld+json" set:html={jsonLd} />
</BaseLayout>

<style>
  .article-shell {
    background: color-mix(in srgb, var(--paper) 96%, transparent);
    border: 1px solid rgb(255 255 255 / 28%);
    border-radius: 1.5rem;
    box-shadow: var(--shadow);
    margin: clamp(2rem, 6vw, 5rem) auto;
    max-width: 54rem;
    padding: clamp(1.3rem, 5vw, 4.5rem);
  }
  .back { color: var(--teal-dark); font-weight: 750; text-decoration: none; }
  .back:hover { text-decoration: underline; text-underline-offset: 0.25em; }
  header { border-bottom: 1px solid #d8e3e2; margin: 3rem 0 2.5rem; padding-bottom: 2rem; }
  h1 { font-size: clamp(2.5rem, 8vw, 5.5rem); letter-spacing: -0.06em; line-height: 0.98; margin: 0.25rem 0 1.5rem; }
  time { color: var(--slate); font-size: 0.9rem; font-weight: 700; }
  .archive-note { color: var(--slate); font-size: 0.95rem; line-height: 1.6; margin: 1rem 0 0; max-width: 38rem; }
</style>
