---
import { SOCIAL_LINKS } from '../consts'
import ActionIcon from './ActionIcon.astro'
---

<ul class="social-links" aria-label="More ways to find Nathan">
  {SOCIAL_LINKS.map((link) => (
    <li>
      <a
        class="action-with-icon"
        href={link.href}
        rel={link.external ? 'me noopener noreferrer' : undefined}
        target={link.external ? '_blank' : undefined}
        aria-label={link.external ? `${link.label}, opens in a new tab` : undefined}
      >
        {link.label}<ActionIcon direction={link.external ? 'up-right' : 'right'} />
      </a>
    </li>
  ))}
</ul>

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li { min-width: 0; }

  a {
    align-items: center;
    background: var(--paper);
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--ink);
    display: inline-flex;
    font-weight: 700;
    min-height: var(--tap-target);
    padding: 0.72rem 1rem;
    text-decoration: none;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  a:active {
    background: var(--sunset-soft);
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover {
      background: var(--sunset-soft);
      transform: translateY(-2px);
    }
  }

  @media (max-width: 560px) {
    .social-links {
      display: grid;
      gap: 0.5rem;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
    }

    a {
      justify-content: center;
      padding-inline: 0.65rem;
      width: 100%;
    }
  }

  @media (max-width: 350px) {
    .social-links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    li:last-child { grid-column: 1 / -1; }
  }
</style>
