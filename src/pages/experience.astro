---
import ActionIcon from '../components/ActionIcon.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { RESUME } from '../consts'

const description = 'Nathan Bland\'s work history, selected projects, technical experience, and education.'
---

<!--
THESIS: Give hiring readers a complete, scannable record backed by the same data as the downloadable resume.
OWN-WORLD: Extend the Trail Notebook with one pale resume sheet, a chronological route, and compact field labels.
STORY: Establish current scope, show the full work record, add project evidence, then close with education and contact.
FIRST VIEWPORT: The page purpose and PDF action appear before the full chronology.
FORM: A dedicated evidence surface inside the existing portfolio world.
-->

<BaseLayout title="Experience" description={description}>
  <section class="resume-hero" aria-labelledby="page-heading">
    <div>
      <p class="eyebrow">Resume</p>
      <h1 id="page-heading">Experience</h1>
      <p class="lede">
        I build product interfaces and the systems behind them, mostly with React and TypeScript.
      </p>
    </div>
    <div class="resume-download">
      <a class="download-action action-with-icon" href="/nathan-bland-resume.pdf" download>
        Download resume<ActionIcon direction="down" />
      </a>
    </div>
  </section>

  <section class="resume-sheet" aria-labelledby="work-heading">
    <header class="sheet-heading">
      <div>
        <p class="eyebrow">Work history</p>
        <h2 id="work-heading">Professional experience</h2>
      </div>
      <p>{RESUME.experience.length} roles since 2011</p>
    </header>

    <ol class="role-list">
      {RESUME.experience.map((item) => (
        <li class:list={{ current: item.current }}>
          <span class="role-marker" aria-hidden="true"></span>
          <article>
            <header class="role-heading">
              <div>
                <h3>{item.role}</h3>
                <p class="company">{item.company}</p>
              </div>
              {item.current && <span class="current-status">Current role</span>}
            </header>
            <p class="role-meta">
              {item.period}{item.location ? ` · ${item.location}` : ''}
            </p>
            {item.summary && <p class="role-summary">{item.summary}</p>}
            {item.highlights.length > 0 && (
              <ul class="role-highlights">
                {item.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
            )}
            {item.tools.length > 0 && (
              <ul class="tool-list" aria-label={`Tools used at ${item.company}`}>
                {item.tools.map((tool) => <li>{tool}</li>)}
              </ul>
            )}
          </article>
        </li>
      ))}
    </ol>
  </section>

  <section class="projects" aria-labelledby="projects-heading">
    <header>
      <p class="eyebrow">Projects</p>
      <h2 id="projects-heading">Selected work</h2>
    </header>
    <div class="project-grid">
      {RESUME.projects.map((project) => (
        <article>
          <p class="project-label">{project.label}</p>
          <h3>{project.name}</h3>
          <p>{project.summary}</p>
          <ul class="tool-list" aria-label={`Tools used for ${project.name}`}>
            {project.tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="credentials" aria-label="Skills and education">
    <section aria-labelledby="skills-heading">
      <p class="eyebrow">Technical scope</p>
      <h2 id="skills-heading">Tools used</h2>
      <dl class="skill-groups">
        {RESUME.skills.map((group) => (
          <div>
            <dt>{group.label}</dt>
            <dd>{group.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="education-heading">
      <p class="eyebrow">Education</p>
      <h2 id="education-heading">{RESUME.education.school}</h2>
      <p>{RESUME.education.degree}</p>
      <p class="credential-meta">{RESUME.education.period}</p>
      {RESUME.certifications.map((certification) => (
        <div class="certification">
          <p class="credential-label">Certification</p>
          <h3>{certification.name}</h3>
          <p>{certification.issuer}</p>
        </div>
      ))}
    </section>
  </section>

  <section class="resume-contact" aria-labelledby="contact-heading">
    <div>
      <p class="eyebrow">Contact</p>
      <h2 id="contact-heading">Want to talk?</h2>
    </div>
    <a class="action-with-icon" href={`mailto:${RESUME.email}`}>
      {RESUME.email}<ActionIcon />
    </a>
  </section>
</BaseLayout>

<style>
  .resume-hero {
    align-items: end;
    display: grid;
    gap: clamp(2rem, 7vw, 6rem);
    grid-template-columns: minmax(0, 1.25fr) minmax(15rem, 0.75fr);
    padding: clamp(2rem, 7vw, 5rem) clamp(0rem, 3vw, 2rem) clamp(3rem, 8vw, 6rem);
  }

  .resume-hero > * { min-width: 0; }
  .resume-hero .eyebrow { color: var(--sunset); }

  h1 {
    color: var(--paper);
    font-size: clamp(3rem, 8vw, 6.8rem);
    letter-spacing: calc(var(--heading-tracking-tight) + var(--heading-tracking-offset));
    line-height: 0.88;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .lede {
    color: var(--mist);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: calc(var(--paragraph-leading) + 0.05);
    margin: 1.35rem 0 0;
    max-width: 43rem;
  }

  .resume-download { justify-self: end; max-width: 20rem; }

  .download-action {
    align-items: center;
    background: var(--sunset);
    border-radius: 999px;
    color: var(--ink);
    display: inline-flex;
    font-weight: 800;
    min-height: var(--tap-target);
    padding: 0.8rem 1.1rem;
    text-decoration: none;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .download-action:hover { background: var(--sunset-soft); transform: translateY(-2px); }
  }

  .resume-sheet {
    background: var(--paper-article);
    border-radius: 1.5rem;
    box-shadow: var(--shadow);
    margin-bottom: calc(clamp(3rem, 7vw, 5rem) + var(--section-spacing-offset));
    padding: calc(clamp(1.5rem, 5vw, 4rem) + var(--surface-padding-offset));
  }

  .sheet-heading {
    align-items: end;
    border-bottom: 1px solid var(--article-line);
    display: flex;
    gap: 2rem;
    justify-content: space-between;
    padding-bottom: 2rem;
  }

  .sheet-heading > div { min-width: 0; }
  .sheet-heading .eyebrow { color: var(--teal-dark); }

  .sheet-heading h2,
  .projects h2,
  .credentials h2,
  .resume-contact h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: calc(var(--heading-tracking-tight) + var(--heading-tracking-offset));
    line-height: 1;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .sheet-heading > p {
    color: var(--slate);
    flex-shrink: 0;
    font-size: 0.9rem;
    font-weight: 700;
    margin: 0;
  }

  .role-list {
    list-style: none;
    margin: 0;
    padding: 2.5rem 0 0;
  }

  .role-list > li {
    min-width: 0;
    padding: 0 0 3rem 2.3rem;
    position: relative;
  }

  .role-list > li:last-child { padding-bottom: 0; }

  .role-list > li::before {
    background: var(--article-line);
    content: '';
    inset-block: 0 -0.1rem;
    inset-inline-start: 0.38rem;
    position: absolute;
    width: 1px;
  }

  .role-list > li:last-child::before { inset-block-end: calc(100% - 0.9rem); }

  .role-marker {
    background: var(--teal-dark);
    border: 3px solid var(--paper);
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--teal-dark);
    height: 0.82rem;
    inset-block-start: 0.18rem;
    inset-inline-start: 0;
    position: absolute;
    width: 0.82rem;
    z-index: 1;
  }

  .current .role-marker {
    background: var(--sunset);
    box-shadow: 0 0 0 2px var(--ink);
  }

  .role-heading {
    align-items: start;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
  }

  .role-heading > div { min-width: 0; }

  .role-heading h3,
  .project-grid h3,
  .certification h3 {
    color: var(--ink);
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    letter-spacing: calc(var(--heading-tracking-compact) + var(--heading-tracking-offset));
    line-height: 1.1;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .company {
    color: var(--ink-soft);
    font-size: 1.08rem;
    font-weight: 750;
    margin: 0.35rem 0 0;
  }

  .current-status {
    color: var(--teal-dark);
    flex-shrink: 0;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .role-meta,
  .credential-meta {
    color: var(--slate);
    font-size: 0.9rem;
    font-weight: 700;
    margin: 0.6rem 0 0;
  }

  .role-summary,
  .role-highlights {
    color: var(--ink-soft);
    line-height: var(--paragraph-leading);
    max-width: 46rem;
  }

  .role-summary { margin: 1rem 0 0; }
  .role-highlights { margin: 0.65rem 0 0; padding-left: 1.15rem; }
  .role-highlights li + li { margin-top: 0.35rem; }

  .tool-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .tool-list li {
    background: var(--code-paper);
    border: 1px solid var(--article-line);
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.4;
    padding: 0.32rem 0.65rem;
  }

  .projects {
    background: var(--ink-panel);
    border: 1px solid var(--line);
    border-radius: 1.5rem;
    margin-bottom: calc(clamp(3rem, 7vw, 5rem) + var(--section-spacing-offset));
    padding: calc(clamp(1.25rem, 4vw, 2.5rem) + var(--surface-padding-offset));
  }

  .projects > header { margin-bottom: 1.5rem; }
  .projects .eyebrow { color: var(--teal); }
  .projects h2 { color: var(--paper); }

  .project-grid { display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .project-grid article {
    background: var(--paper-card);
    border-radius: 1.25rem;
    min-width: 0;
    padding: 1.5rem;
  }

  .project-label {
    color: var(--teal-dark);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin: 0 0 0.55rem;
    text-transform: uppercase;
  }

  .project-grid article > p:not(.project-label) {
    color: var(--ink-soft);
    line-height: var(--paragraph-leading);
    margin: 0.9rem 0 0;
  }

  .credentials {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-bottom: calc(clamp(3rem, 7vw, 5rem) + var(--section-spacing-offset));
  }

  .credentials > section {
    background: var(--paper-article);
    border-radius: 1.5rem;
    box-shadow: var(--shadow);
    min-width: 0;
    padding: calc(clamp(1.25rem, 4vw, 2.5rem) + var(--surface-padding-offset));
  }

  .credentials .eyebrow { color: var(--teal-dark); }
  .credentials h2 { color: var(--ink); font-size: clamp(2rem, 5vw, 3.5rem); }

  .skill-groups { margin: 1.5rem 0 0; }
  .skill-groups > div + div { border-top: 1px solid var(--article-line); margin-top: 1rem; padding-top: 1rem; }
  .skill-groups dt { color: var(--ink); font-weight: 800; }
  .skill-groups dd { color: var(--ink-soft); line-height: var(--paragraph-leading); margin: 0.3rem 0 0; }

  .credentials section > p:not(.eyebrow, .credential-meta),
  .certification > p:not(.credential-label) {
    color: var(--ink-soft);
    line-height: var(--paragraph-leading);
    margin: 0.65rem 0 0;
  }

  .certification { border-top: 1px solid var(--article-line); margin-top: 1.5rem; padding-top: 1.5rem; }
  .credential-label { color: var(--sunset); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.08em; margin: 0 0 0.5rem; text-transform: uppercase; }
  .certification h3 { font-size: 1.3rem; }

  .resume-contact {
    align-items: end;
    border-top: 1px solid var(--line);
    display: flex;
    gap: 2rem;
    justify-content: space-between;
    padding: clamp(2.5rem, 7vw, 5rem) 0 1rem;
  }

  .resume-contact > div { min-width: 0; }
  .resume-contact .eyebrow { color: var(--sunset); }
  .resume-contact h2 { color: var(--paper); }

  .resume-contact > a {
    align-items: center;
    color: var(--teal);
    display: inline-flex;
    flex-shrink: 1;
    font-size: clamp(1.05rem, 2.5vw, 1.3rem);
    font-weight: 750;
    min-height: var(--tap-target);
    overflow-wrap: anywhere;
    text-align: end;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 760px) {
    .resume-hero { align-items: start; grid-template-columns: 1fr; }
    .resume-download { justify-self: start; }
    .credentials { grid-template-columns: 1fr; }
  }

  @media (max-width: 620px) {
    .sheet-heading { align-items: start; flex-direction: column; gap: 0.75rem; }
    .project-grid { grid-template-columns: 1fr; }
    .resume-contact { align-items: start; flex-direction: column; gap: 1rem; }
    .resume-contact > a { text-align: start; }
  }

  @media (max-width: 440px) {
    .role-heading { display: block; }
    .current-status { display: inline-block; margin-top: 0.65rem; }
    .role-list > li { padding-inline-start: 1.8rem; }
  }
</style>
