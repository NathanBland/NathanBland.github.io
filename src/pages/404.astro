---
import ActionIcon from '../components/ActionIcon.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Page not found" description="The requested page could not be found.">
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1 class="section-heading">This trail goes nowhere.</h1>
    <p class="section-intro">The page may have moved, or perhaps it never existed.</p>
    <a class="action-with-icon" href="/">
      Head home<ActionIcon />
    </a>
  </section>
</BaseLayout>

<style>
  .not-found { min-height: 65vh; padding: clamp(4rem, 12vw, 9rem) 0; }
  .not-found .eyebrow { color: var(--sunset); }
  .not-found a { align-items: center; background: var(--paper); border-radius: 999px; display: inline-flex; font-weight: 750; margin-top: 2rem; min-height: var(--tap-target); padding: 0.8rem 1rem; text-decoration: none; }
</style>
