---
interface Props {
  direction?: 'down' | 'left' | 'right' | 'up-right'
}

const { direction = 'right' } = Astro.props
---

<svg
  class:list={['action-icon', `action-icon--${direction}`]}
  width="16"
  height="16"
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width="1.5"
  aria-hidden="true"
  focusable="false"
>
  {direction === 'left' && <path d="M13.25 8H2.75m4-4-4 4 4 4" />}
  {direction === 'right' && <path d="M2.75 8h10.5m-4-4 4 4-4 4" />}
  {direction === 'up-right' && <path d="M4 12 12 4M6.25 4H12v5.75" />}
  {direction === 'down' && <path d="M8 2.5v8m-3-3 3 3 3-3M3 13.5h10" />}
</svg>
