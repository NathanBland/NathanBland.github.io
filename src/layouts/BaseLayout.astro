---
import SiteHeader from '../components/SiteHeader.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  image?: string
  article?: boolean
  publishedTime?: string
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = '/avatar.png',
  article = false,
  publishedTime
} = Astro.props

const pageTitle = title === SITE_TITLE ? SITE_TITLE : `${title} | ${SITE_TITLE}`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const imageURL = new URL(image, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10212b" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} RSS feed`} href="/rss.xml" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content={SITE_TITLE} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="background" aria-hidden="true"></div>
    <div class="page-frame">
      <SiteHeader />
      <main id="main-content">
        <slot />
      </main>
      <footer>
        <p>&copy; {new Date().getFullYear()} Nathan Bland</p>
        <a href="/rss.xml">RSS</a>
      </footer>
    </div>
  </body>
</html>
